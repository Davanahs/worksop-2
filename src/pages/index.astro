---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-400" data-testid="games-result-count">
          Showing {games.length} {games.length === 1 ? 'game' : 'games'}
        </p>
      </div>

      <form class="grid gap-4 mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 sm:grid-cols-2" data-testid="game-filters">
        <div>
          <label for="category-filter" class="block mb-2 text-sm font-medium text-slate-200">Category</label>
          <select
            id="category-filter"
            name="category"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="category-filter"
          >
            <option value="">All categories</option>
            {categories.map((category) => <option value={category.id}>{category.name}</option>)}
          </select>
        </div>
        <div>
          <label for="publisher-filter" class="block mb-2 text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <button
            type="button"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
        </div>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="games-result-count"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (categoryFilter && publisherFilter && clearFilters && resultCount && gamesGrid && emptyState) {
    const validCategoryIds = new Set(Array.from(categoryFilter.options).map((option) => option.value).filter(Boolean));
    const validPublisherIds = new Set(Array.from(publisherFilter.options).map((option) => option.value).filter(Boolean));
    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('category');
    const initialPublisher = params.get('publisher');

    if (initialCategory && validCategoryIds.has(initialCategory)) categoryFilter.value = initialCategory;
    if (initialPublisher && validPublisherIds.has(initialPublisher)) publisherFilter.value = initialPublisher;

    const updateFilters = () => {
      const category = categoryFilter.value;
      const publisher = publisherFilter.value;
      const nextParams = new URLSearchParams();
      if (category) nextParams.set('category', category);
      if (publisher) nextParams.set('publisher', publisher);
      const nextUrl = nextParams.toString() ? `/?${nextParams.toString()}` : '/';
      window.history.replaceState({}, '', nextUrl);

      let visibleCount = 0;
      cards.forEach((card) => {
        const matchesCategory = !category || card.dataset.categoryId === category;
        const matchesPublisher = !publisher || card.dataset.publisherId === publisher;
        const visible = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      });

      gamesGrid.classList.toggle('hidden', visibleCount === 0);
      emptyState.classList.toggle('hidden', visibleCount !== 0);
      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    };

    categoryFilter.addEventListener('change', updateFilters);
    publisherFilter.addEventListener('change', updateFilters);
    clearFilters.addEventListener('click', () => {
      categoryFilter.value = '';
      publisherFilter.value = '';
      updateFilters();
    });
    updateFilters();
  }
</script>
